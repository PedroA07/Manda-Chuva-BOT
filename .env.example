# Copie este arquivo para .env (no seu PC). Na hospedagem, coloque as mesmas variáveis no painel dela.

# Token do bot (Developer Portal → sua aplicação → Bot → Reset Token)
DISCORD_TOKEN=

# Senha que a interface web pede (mínimo 12 caracteres).
# Sem senha, a API só aceita acesso do próprio computador (bom pra testar no PC).
PAINEL_SENHA=

# Sites que podem usar a API, separados por vírgula. Endereços localhost sempre podem.
PAINEL_ORIGENS=https://pedroa07.github.io

# Porta da API (padrão 3000; a hospedagem costuma definir PORT, que tem prioridade). 0 desliga a API.
PAINEL_PORTA=3000

# Opcional: guarda a configuração num Gist secreto do GitHub em vez da pasta dados/.
# Necessário em hospedagem que apaga os arquivos ao reiniciar (Render grátis).
GIST_ID=
GIST_TOKEN=

# 1 = acessa o próprio endereço a cada 10 min pra hospedagem grátis não desligar.
# Usa URL_PUBLICA ou, na Render, o RENDER_EXTERNAL_URL que ela mesma define.
MANTER_ACORDADO=
URL_PUBLICA=

# 1 = esta cópia só serve o painel e NÃO responde aos botões.
# Use no seu PC quando o bot de verdade estiver rodando numa hospedagem.
SO_PAINEL=
